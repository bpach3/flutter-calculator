{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/todo-app.schema.json",
  "title": "ToDo App Firestore Database",
  "type": "object",
  "properties": {
    "users": {
      "description": "Collection of user documents, keyed by document ID.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/user" }
    },
    "tasks": {
      "description": "Collection of task documents, keyed by document ID.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "timestamp": {
      "description": "Firestore timestamp, represented as an ISO 8601 date-time string.",
      "type": "string",
      "format": "date-time"
    },
    "user": {
      "title": "User",
      "type": "object",
      "properties": {
        "birthdate": { "$ref": "#/$defs/timestamp" },
        "created_time": { "$ref": "#/$defs/timestamp" },
        "display_name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photo_url": {
          "description": "Profile photo URL. May be an empty string.",
          "type": "string"
        }
      },
      "required": [
        "birthdate",
        "created_time",
        "display_name",
        "email",
        "photo_url"
      ],
      "additionalProperties": false
    },
    "task": {
      "title": "Task",
      "type": "object",
      "properties": {
        "completed": { "type": "boolean" },
        "created": { "$ref": "#/$defs/timestamp" },
        "details": { "type": "string" },
        "title": { "type": "string", "minLength": 1 }
      },
      "required": ["completed", "created", "details", "title"],
      "additionalProperties": false
    }
  }
}
